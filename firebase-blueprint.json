{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Personal information and fitness profile of the user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "age": { "type": "integer" },
        "weight": { "type": "number", "description": "Weight in kg" },
        "height": { "type": "number", "description": "Height in cm" },
        "activityLevel": { "type": "string", "enum": ["sedentary", "light", "moderate", "active", "very_active"] },
        "fitnessGoals": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Goal": {
      "title": "Fitness Goal",
      "description": "A specific fitness goal set by the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["in_progress", "completed", "abandoned"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title"]
    },
    "Workout": {
      "title": "Daily Workout",
      "description": "Suggested workout generated by AI.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "exercises": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "reps": { "type": "string" },
              "sets": { "type": "integer" },
              "duration": { "type": "string" }
            }
          }
        },
        "difficulty": { "type": "string" },
        "estimatedTime": { "type": "integer", "description": "Duration in minutes" },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "title"]
    },
    "Log": {
      "title": "Workout Log",
      "description": "Record of a completed workout.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "workoutId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration": { "type": "integer" },
        "notes": { "type": "string" }
      },
      "required": ["userId", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "User specific fitness goals"
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": "Workout",
      "description": "History of suggested workouts"
    },
    "/users/{userId}/logs/{logId}": {
      "schema": "Log",
      "description": "Activity logs for the user"
    }
  }
}
