rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 128) &&
             (data.get('age', 0) is int && data.get('age', 0) >= 0 && data.get('age', 0) <= 150) &&
             (data.get('weight', 0.0) is number && data.get('weight', 0.0) >= 0) &&
             (data.get('height', 0.0) is number && data.get('height', 0.0) >= 0) &&
             (data.get('activityLevel', 'sedentary') in ['sedentary', 'light', 'moderate', 'active', 'very_active']);
    }

    function isValidGoal(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() <= 256 &&
             (data.get('status', 'in_progress') in ['in_progress', 'completed', 'abandoned']);
    }

    function isValidWorkout(data, userId) {
      return data.userId == userId &&
             data.date is string && // Simple date string YYYY-MM-DD
             data.title is string && data.title.size() <= 256 &&
             data.exercises is list;
    }

    function isValidLog(data, userId) {
      return data.userId == userId &&
             data.date is timestamp;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'age', 'weight', 'height', 'activityLevel', 'fitnessGoals'])
      );

      match /goals/{goalId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGoal(incoming(), userId);
        allow update: if isOwner(userId) && isValidGoal(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'targetDate', 'status'])
        );
        allow delete: if isOwner(userId);
      }

      match /workouts/{workoutId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWorkout(incoming(), userId);
        allow update: if isOwner(userId) && isValidWorkout(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['exercises', 'difficulty', 'estimatedTime'])
        );
        allow delete: if isOwner(userId);
      }

      match /logs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLog(incoming(), userId);
        allow update: if isOwner(userId) && isValidLog(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['duration', 'notes'])
        );
        allow delete: if isOwner(userId);
      }
    }
  }
}
